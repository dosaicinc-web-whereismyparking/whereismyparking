# ─────────────────────────────────────────────────────────────────────────────
# WhereIsMyParking — Environment Variables Reference
# Copy this to .env.local for local development.
# On Hetzner, set these as system environment variables on each node.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Public — baked into client bundle at build time) ────────────────
# Local dev: http://127.0.0.1:54321
# Hetzner: The NEXT_PUBLIC_ URL is only used by the browser-side Supabase client.
#          Since auth is handled by our custom JWT flow and browser reads local storage,
#          the value below is used for reference — keep it consistent with your setup.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Supabase (Server-Side — private, NOT exposed to browser) ─────────────────
# SUPABASE_INTERNAL_URL: PostgREST endpoint reachable from App nodes.
#   Local dev: http://127.0.0.1:54321 (default, no need to set)
#   Hetzner:   http://<supabase-node-private-ip>:54321
SUPABASE_INTERNAL_URL=http://127.0.0.1:54321

# SUPABASE_AUTH_URL: GoTrue endpoint reachable from App nodes.
#   Local dev: http://127.0.0.1:9999 (default, no need to set)
#   Hetzner:   http://<supabase-node-private-ip>:9999
SUPABASE_AUTH_URL=http://127.0.0.1:9999

# Service role key — bypasses RLS, server-side only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT secret — must be identical on ALL nodes (App-1, App-2, Supabase node)
SUPABASE_JWT_SECRET=your_jwt_secret_min_32_chars

# ── SMS Provider ──────────────────────────────────────────────────────────────
# Fast2SMS key — used for OTP delivery
FAST2SMS_API_KEY=your_fast2sms_api_key

# ── Authentication ────────────────────────────────────────────────────────────
# OTP hash salt — must be identical on ALL app nodes
AUTH_SALT=your_secret_salt_string

# Comma-separated admin mobile numbers (with country code, e.g. +919876543210)
ADMIN_WHITELISTED_MOBILES=+91xxxxxxxxxx

# Dev bypass — set to false in production (bypasses all auth if true)
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# ── Maps ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAP_PROVIDER=maplibre
# Free tile server — fine for test period
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ── Database (direct connection — used by scripts/migrations only) ────────────
# Local dev only. On Hetzner, app nodes never connect directly to Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── docker-compose (Supabase node — set in .env.supabase or as system env) ───
# GoTrue / Supabase stack config
POSTGRES_PASSWORD=your_postgres_password
JWT_SECRET=your_jwt_secret_min_32_chars

# Your public domain (used by GoTrue for redirect URLs)
# Hetzner: https://yourdomain.com
GOTRUE_SITE_URL=http://localhost:3000

# PostgREST API URL visible to GoTrue and Studio on the Supabase node
# Hetzner: http://<supabase-node-private-ip>:54321
SUPABASE_API_URL=http://localhost:54321

# Set to false in production — enables real SMS OTP delivery
# true = auto-confirm OTP (dev only)
GOTRUE_SMS_AUTOCONFIRM=true

# PostgREST connection pool — 25 is safe for 500 concurrent users
PGRST_DB_POOL=25
