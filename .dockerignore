# Docker ignore — keep build context lean and avoid leaking secrets

# Dependencies (reinstalled inside Docker)
node_modules
.npm-cache

# Build output (regenerated by docker build)
.next
/build
/out

# Local env files — NEVER copy secrets into the image
.env
.env.*
.env.local
.env.production

# Version control
.git
.gitignore

# Dev tools and planning
.planning
.kilo
.codex
scratch
tests

# OS artifacts
.DS_Store
*.pem
Thumbs.db

# Logs
*.log
dev.log
dev_err.log
errors.log
server.log
startup.log

# TypeScript build info (regenerated)
*.tsbuildinfo

# Debug / diagnostic scripts (not needed in container)
*.sh
*.ps1
*.sql
*.txt
extract_doc.ps1

# Docs
*.docx
